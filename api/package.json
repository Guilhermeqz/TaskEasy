{
  "name": "taskeasy-api",
  "version": "0.1.0",
  "private": true,
  "description": "API do projeto acadêmico TaskEasy",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "backup": "node scripts/backup.js",
    "cloud:check": "node --env-file=.env.cloud scripts/cloud-check.js",
    "cloud:verify": "node --env-file=.env.cloud scripts/verify-cloud.js",
    "cloud:migrate": "node --env-file=.env.cloud scripts/migrate-cloud.js",
    "test": "node --test",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:cloud": "node --env-file=.env.cloud src/server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
